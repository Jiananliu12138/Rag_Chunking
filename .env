# ── 应用 ──────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── 路径 / Milvus 存储 ───────────────────────────────────────────────────────
# MILVUS_DATA_DIR 非空 → 使用本地 Milvus Lite，数据文件位于该目录下（<collection>.db）
# MILVUS_DATA_DIR 为空且配置 MILVUS_URI → 使用在线 Milvus / Milvus Server
# 两者都为空 → 回退到默认 Lite 目录（./milvus_data）
MILVUS_DATA_DIR=/data/h50056789/Rag_Chunking/test_database
MILVUS_URI=

# tiktoken 本地缓存目录（可选）
TIKTOKEN_CACHE_DIR=/data/h50056789/Rag_Chunking/tiktoken_cache

# ── 嵌入模型默认配置 ──────────────────────────────────────────────────────────
DEFAULT_EMBEDDING_MODEL=/data/h50056789/Rag_chunk_bench/model/bge-large-en-v1.5
DEFAULT_EMBEDDING_DIM=1024

# ── LLM 默认配置 ─────────────────────────────────────────────────────────────
DEFAULT_VLLM_API_BASE=http://localhost:8005/v1
DEFAULT_VLLM_MODEL_NAME=Qwen2.5-7B-Instruct
DEFAULT_LLM_TEMPERATURE=0.1
DEFAULT_LLM_MAX_TOKENS=1280

# ── 评估默认配置 ─────────────────────────────────────────────────────────────
DEFAULT_ENABLE_BERT_SCORE=false
DEFAULT_BERT_SCORE_MODEL=roberta-large
DEFAULT_BERT_SCORE_DEVICE=cuda:0

# ── RAGAS 评估默认配置 ───────────────────────────────────────────────────────
DEFAULT_RAGAS_VLLM_API_BASE=http://localhost:8005/v1
DEFAULT_RAGAS_VLLM_API_KEY=EMPTY
DEFAULT_RAGAS_VLLM_MODEL_NAME=
DEFAULT_RAGAS_EMBEDDING_MODEL_PATH=
DEFAULT_RAGAS_DEVICE=cuda:0
DEFAULT_RAGAS_ENABLE_CACHE=true
DEFAULT_RAGAS_CACHE_DIR=./ragas_cache

# ── 组件级评估默认配置 ───────────────────────────────────────────────────────
# Chunk 质量评估（BC + 语义不相似度）
COMPONENT_PPL_MODEL_PATH=/data/h50056789/Rag_Chunking/model/Qwen/Qwen2.5-7B-Instruct
COMPONENT_SIM_MODEL_PATH=/data/h50056789/Rag_chunk_bench/model/bge-large-en-v1.5
COMPONENT_ENABLE_SEMANTIC_SIMILARITY=true
COMPONENT_ENABLE_BOUNDARY_CLARITY=true

# Chunk 黏连度评估（结构熵）
STICKINESS_MODEL_PATH=/data/h50056789/Rag_Chunking/model/Qwen/Qwen2.5-7B-Instruct
STICKINESS_THRESHOLD=0.8
STICKINESS_DELTA=0.1

# ── Milvus / Hybrid Search 配置 ─────────────────────────────────────────────
# 是否启用稀疏向量（BM25），默认 true
MILVUS_ENABLE_SPARSE=true
# 是否在检索阶段使用 Hybrid Search（dense + sparse），默认 true
MILVUS_ENABLE_HYBRID_SEARCH=true
# Hybrid Search 使用的 ranker（RRFRanker 或 WeightedRanker）
MILVUS_HYBRID_RANKER=RRFRanker
# RRFRanker 的 k 参数（仅在 RRFRanker 时生效）
MILVUS_HYBRID_RANKER_K=60
