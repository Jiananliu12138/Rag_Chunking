# Storage / runtime
MILVUS_DATA_DIR=/data/h50056789/Rag_Chunking/milvus_data
MILVUS_URI=
TIKTOKEN_CACHE_DIR=/data/h50056789/Rag_Chunking/tiktoken_cache
CHUNK_NUM_WORKERS=4

# Embedding defaults
DEFAULT_EMBEDDING_MODEL=/data/h50056789/Rag_Chunking/model/BAAI/bge-m3
DEFAULT_EMBEDDING_DEVICE=cuda:0
DEFAULT_EMBEDDING_DIM=1024
DEFAULT_EMBEDDING_MAX_TOKENS=8192

# Shared model defaults
DEFAULT_LLM_API_BASE=http://localhost:8001/v1
DEFAULT_LLM_API_KEY=EMPTY
DEFAULT_LLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8
DEFAULT_LLM_TEMPERATURE=0.0
DEFAULT_LLM_MAX_TOKENS=65536

DEFAULT_RETRIEVE_TOP_K=5
DEFAULT_RERANK_MODEL=/data/h50056789/Rag_Chunking/model/BAAI/bge-reranker-v2-m3
DEFAULT_RERANK_DEVICE=cuda:0
DEFAULT_RERANK_MAX_LENGTH=8192

# Milvus / hybrid search
MILVUS_ENABLE_SPARSE=true
MILVUS_ENABLE_HYBRID_SEARCH=true
MILVUS_HYBRID_RANKER=RRFRanker
MILVUS_HYBRID_RANKER_K=60

# Traditional evaluation defaults
DEFAULT_ENABLE_BERT_SCORE=false
DEFAULT_BERT_SCORE_MODEL=roberta-large
DEFAULT_BERT_SCORE_DEVICE=cuda:0

# RAGAS evaluation runtime defaults
DEFAULT_RAGAS_DEVICE=cuda:0
DEFAULT_RAGAS_ENABLE_CACHE=true
DEFAULT_RAGAS_CACHE_DIR=./ragas_cache

# Component evaluation defaults
COMPONENT_ENABLE_SEMANTIC_SIMILARITY=true
COMPONENT_ENABLE_BOUNDARY_CLARITY=true
COMPONENT_SCORE_TEMPERATURE=6.0

# Stickiness evaluation defaults
STICKINESS_THRESHOLD=0.6
STICKINESS_DELTA=0.05
STICKINESS_SCORE_TEMPERATURE=6.0
